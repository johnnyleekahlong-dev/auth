{
  "compilerOptions": {
    "target": "es2016",
    "module": "NodeNext",
    "rootDir": ".",
    "outDir": "./dist",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "src/types/**/*", "api/*.ts"],
  "exclude": ["node_modules"]
}
